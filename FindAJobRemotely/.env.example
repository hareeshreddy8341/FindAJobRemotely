# Copy to .env and fill in. NEVER commit the real .env file.

MONGO_USER=fajr
MONGO_PASSWORD=change-me-to-a-long-random-value

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (losing this key makes encrypted phone numbers and resumes unreadable - back it up)
DATA_ENCRYPTION_KEY=

# First administrator, created at start-up if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true when served over HTTPS (required in production). Set false only for plain-http local testing.
COOKIE_SECURE=true
PUBLIC_ORIGIN=http://localhost
COMMISSION_PERCENT=10
